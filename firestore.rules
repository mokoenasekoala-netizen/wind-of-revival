rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isCrew() {
      return request.auth != null &&
        request.auth.token.email in ['mokoenasekoala@gmail.com'];
    }
    match /sermons/{id}      { allow read: if true; allow write: if isCrew(); }
    match /settings/{id}     { allow read: if true; allow write: if isCrew(); }
    match /gallery/{id}      { allow read: if true; allow write: if isCrew(); }
    match /testimonies/{id}  { allow read: if true; allow write: if isCrew(); }
  }
}
