rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isCrew() {
      return request.auth != null &&
        request.auth.token.email in ['crew1@gmail.com', 'crew2@gmail.com'];
    }
    match /sermons/{id}  { allow read: if true; allow write: if isCrew(); }
    match /settings/{id} { allow read: if true; allow write: if isCrew(); }
  }
}
